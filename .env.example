# Get your API key at https://upres.ai/app/settings/api
# Business tier ($49/mo) or PRO ($19/mo, 100 ops)
UPRES_API_KEY=upres_your_key_here

# Upscale factor: 2, 4, or 8 (default: 4)
UPRES_SCALE=4

# Model (default: wavespeed-ai/real-esrgan)
# Options: aura-sr, clarity-upscaler, esrgan-v1-x2plus
UPRES_MODEL=wavespeed-ai/real-esrgan
