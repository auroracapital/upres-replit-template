# Get your API key at https://upres.ai/app/settings/api
UPRES_API_KEY=upres_your_key_here

# Scale for enlarging aliases: 2, 4, or 8 (default: 4).
# hush, keen, and visage ignore this and stay at the source size.
UPRES_SCALE=4

# Public alias. Default: flare.
# Image: flare, prism, lumen, mirage, hush, keen, visage, atelier
UPRES_MODEL=flare
